# Dependencies
node_modules/

# Build output
dist/
dist-core/
public/paged.polyfill.js
public/katex/
src-tauri/target/
src-tauri/gen/

# Dev-session file artifacts. `tauri dev` runs with CWD = src-tauri, so the
# native Save dialog defaults near src-tauri; files saved there (e.g.
# src-tauri/save/) are user/test artifacts, not part of the repository.
src-tauri/save/

# Test artifacts
test-results/
playwright-report/
blob-report/
coverage/

# Generated export artifacts (golden PDFs are regenerated on demand).
# The Phase-0 rendering spike evidence is committed on purpose.
# Local stress/export reports (artifacts/stress-summary.json, *.pdf) are
# regenerable observations — timing figures are machine-specific.
artifacts/*
!artifacts/spike/

# Local env / editor noise
*.local
.DS_Store
.vscode/*
!.vscode/extensions.json
