            "type": "paragraph",
            "content": [
              {
                "text": "Water Quality Monitoring Report",
                "marks": []
              }
            ],
            "style": "title"
          },
          {
            "id": "pg_2iq6v4v7",
            "type": "paragraph",
            "content": [
              {
                "text": "Quarterly compliance summary — Q3 2026",
                "marks": []
              }
            ],
            "style": "subtitle"
          },
          {
            "id": "hd_dfpnh2td",
            "type": "heading",
            "level": 1,
            "content": [
              {
                "text": "Scope",
                "marks": []
              }
            ],
            "style": "heading-1"
          },
          {
            "id": "pg_o5mdgoxo",
            "type": "paragraph",
            "content": [
              {
                "text": "This report summarises routine purified-water monitoring carried out during the quarter.",
                "marks": []
              }
            ],
            "style": "body-text"
          },
          {
            "id": "hd_idar3flo",
            "type": "heading",
            "level": 2,
            "content": [
              {
                "text": "Definitions",
                "marks": []
              }
            ],
            "style": "heading-2"
          },
          {
            "id": "pg_ey9yxzus",
            "type": "paragraph",
            "content": [
              {
                "text": "Purified water: water meeting the specification in SOP-042.",
                "marks": []
              }
            ],
            "style": "definition"
          },
          {
            "id": "hd_qdeq6czj",
            "type": "heading",
            "level": 3,
            "content": [
              {
                "text": "Procedure",
                "marks": []
              }
            ],
            "style": "heading-3"
          },
          {
            "id": "pg_qyjtv64g",
            "type": "paragraph",
            "content": [
              {
                "text": "Samples were collected at the six designated points and analysed daily.",
                "marks": []
              }
            ],
            "style": "body-text"
          },
          {
            "id": "pg_um5tn1xu",
            "type": "paragraph",
            "content": [
              {
                "text": "All collection points met the acceptance criteria in Q3.",
                "marks": []
              }
            ],
            "style": "note"
          },
          {
            "id": "pg_gyctm73r",
            "type": "paragraph",
            "content": [
              {
                "text": "Do not use results outside the validated range for release decisions.",
                "marks": []
              }
            ],
            "style": "warning"
          },
          {
            "id": "pg_phat8wc2",
            "type": "paragraph",
            "content": [
              {
                "text": "Reviewed results are stated in the table below.",
                "marks": []
